# Copy to .env for local use, or set these as Cloud Run env vars.
# Every value has a working default - you only need this file to change one.

# --- Database --------------------------------------------------------------
# Local default: backend/data/scorekeeper.db
# Cloud Run MUST use /tmp (the rest of the filesystem is read-only).
DATABASE_PATH=backend/data/scorekeeper.db

# --- Server ----------------------------------------------------------------
PORT=8080
FLASK_DEBUG=false

# --- CORS ------------------------------------------------------------------
# "*" is fine while developing. Before the final demo, set this to the exact
# frontend origin, e.g. https://your-frontend.web.app
CORS_ORIGINS=*

# --- Scoring rules ---------------------------------------------------------
# The scoreboard does not know the game, so penalties are allowed by default.
ALLOW_NEGATIVE_SCORES=true
MIN_SCORE=-100000
MAX_SCORE=100000

# Not a game rule - just a ceiling so a runaway script cannot flood the table.
MAX_PLAYERS=100

# --- Logging ---------------------------------------------------------------
# true  -> JSON lines (what GCP Cloud Logging parses)
# false -> human-readable text (nicer locally)
JSON_LOGS=true
LOG_LEVEL=INFO
